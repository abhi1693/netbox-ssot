NETBOX_SSOT_CONTROL_ENDPOINT=https://netbox.example.com/api/plugins/ssot/agent/config/
NETBOX_SSOT_AGENT_ID=00000000-0000-4000-8000-000000000000
NETBOX_SSOT_PRIVATE_KEY_REF=file:///run/credentials/netbox-ssot-agent.service/agent-signing-key
NETBOX_TOKEN=replace-with-provider-token
NETBOX_SSOT_LOG_LEVEL=info
# The five-second bootstrap poll is replaced by the NetBox-managed agent setting after the first check-in.
