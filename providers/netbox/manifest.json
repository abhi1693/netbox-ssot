{
  "provider_id": "netbox",
  "display_name": "NetBox",
  "icon_class": "mdi mdi-cube-outline",
  "description": "Collects portable configuration and infrastructure data from a remote NetBox REST API.",
  "instance_url_field": "base_url",
  "implementation_version": "0.0.14",
  "contract_version": "1.0",
  "documentation_url": "https://github.com/abhi1693/netbox-ssot",
  "execution_modes": [
    "agent"
  ],
  "capabilities": [
    "source_read"
  ],
  "agent_compatibility": {
    "protocol_version": "1.0",
    "minimum_agent_version": "0.1.0-alpha.0",
    "collector_id": "netbox"
  },
  "config_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "NetBox source configuration",
    "description": "Connection settings passed to an enrolled Go agent. Secret values remain agent-local.",
    "additionalProperties": false,
    "x-netbox-ssot-order": [
      "base_url",
      "token_ref",
      "verify_tls",
      "page_size",
      "timeout_seconds"
    ],
    "properties": {
      "base_url": {
        "type": "string",
        "title": "NetBox URL",
        "description": "Base URL of the source NetBox instance, without the /api path.",
        "format": "uri",
        "x-netbox-ssot-placeholder": "https://netbox.example.com"
      },
      "token_ref": {
        "type": "string",
        "title": "API token reference",
        "description": "Agent-local env:// or absolute file:/// secret reference. The token itself is never sent to the plugin.",
        "pattern": "^(env://[A-Z_][A-Z0-9_]*|file:///[^\\s?#]+)$",
        "writeOnly": true,
        "x-netbox-ssot-secret": true,
        "x-netbox-ssot-widget": "secret-reference"
      },
      "verify_tls": {
        "type": "boolean",
        "title": "Verify TLS",
        "description": "Require the source certificate to validate against the agent trust store.",
        "default": true
      },
      "page_size": {
        "type": "integer",
        "title": "REST page size",
        "description": "Number of records requested per page. The source NetBox applies its configured MAX_PAGE_SIZE.",
        "default": 500,
        "minimum": 1
      },
      "timeout_seconds": {
        "type": "number",
        "title": "Request timeout",
        "description": "Per-request timeout in seconds.",
        "default": 30,
        "minimum": 1,
        "maximum": 120
      }
    },
    "required": [
      "base_url",
      "token_ref"
    ]
  },
  "secret_fields": [
    "/token_ref"
  ],
  "datasets": [
    {
      "id": "references",
      "title": "Supporting references",
      "description": "Automatically collected ownership, tenancy, tagging, grouping, and ASN dependencies.",
      "resource_kinds": [
        "tag",
        "owner_group",
        "owner",
        "tenant_group",
        "tenant",
        "site_group",
        "rir",
        "role",
        "asn"
      ],
      "default_enabled": false,
      "selectable": false,
      "completeness": "declared_scope",
      "depends_on": [],
      "data_mappings": [
        {"source_name": "Tag", "source_model": "extras.Tag", "source_path": "extras/tags/", "destination_kind": "tag"},
        {"source_name": "Owner group", "source_model": "users.OwnerGroup", "source_path": "users/owner-groups/", "destination_kind": "owner_group"},
        {"source_name": "Owner", "source_model": "users.Owner", "source_path": "users/owners/", "destination_kind": "owner"},
        {"source_name": "Tenant group", "source_model": "tenancy.TenantGroup", "source_path": "tenancy/tenant-groups/", "destination_kind": "tenant_group"},
        {"source_name": "Tenant", "source_model": "tenancy.Tenant", "source_path": "tenancy/tenants/", "destination_kind": "tenant"},
        {"source_name": "Site group", "source_model": "dcim.SiteGroup", "source_path": "dcim/site-groups/", "destination_kind": "site_group"},
        {"source_name": "RIR", "source_model": "ipam.RIR", "source_path": "ipam/rirs/", "destination_kind": "rir"},
        {"source_name": "Role", "source_model": "ipam.Role", "source_path": "ipam/roles/", "destination_kind": "role"},
        {"source_name": "ASN", "source_model": "ipam.ASN", "source_path": "ipam/asns/", "destination_kind": "asn"}
      ]
    },
    {
      "id": "tenancy_contacts",
      "title": "Tenancy contacts",
      "description": "Contact groups, roles, and portable contact details with ownership, grouping, and tagging relationships.",
      "resource_kinds": ["contact_group", "contact_role", "contact"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["references"],
      "data_mappings": [
        {"source_name": "Contact group", "source_model": "tenancy.ContactGroup", "source_path": "tenancy/contact-groups/", "destination_kind": "contact_group"},
        {"source_name": "Contact role", "source_model": "tenancy.ContactRole", "source_path": "tenancy/contact-roles/", "destination_kind": "contact_role"},
        {"source_name": "Contact", "source_model": "tenancy.Contact", "source_path": "tenancy/contacts/", "destination_kind": "contact"}
      ]
    },
    {
      "id": "tenancy_contact_assignments",
      "title": "Tenancy contact assignments",
      "description": "Contact assignments to contact-capable objects represented by this provider. Assignments to unsupported apps are surfaced as skipped records.",
      "resource_kinds": ["contact_assignment"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [
        "tenancy_contacts",
        "ipam_registries",
        "ipam_prefixes",
        "ipam_addresses",
        "ipam_services",
        "regions",
        "sites",
        "locations",
        "device_catalog",
        "racks",
        "devices",
        "power",
        "circuit_catalog",
        "circuits",
        "virtual_circuits",
        "virtualization_machines"
      ],
      "data_mappings": [
        {"source_name": "Contact assignment", "source_model": "tenancy.ContactAssignment", "source_path": "tenancy/contact-assignments/", "destination_kind": "contact_assignment"}
      ]
    },
    {
      "id": "ipam_registries",
      "title": "IPAM registries",
      "description": "ASN ranges and aggregate address space, with RIR, tenancy, ownership, and tagging relationships.",
      "resource_kinds": ["asn_range", "aggregate"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["references"],
      "data_mappings": [
        {"source_name": "ASN range", "source_model": "ipam.ASNRange", "source_path": "ipam/asn-ranges/", "destination_kind": "asn_range"},
        {"source_name": "Aggregate", "source_model": "ipam.Aggregate", "source_path": "ipam/aggregates/", "destination_kind": "aggregate"}
      ]
    },
    {
      "id": "ipam_routing",
      "title": "IPAM routing",
      "description": "Route targets and VRFs, including import and export policy relationships.",
      "resource_kinds": ["route_target", "vrf"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["references"],
      "data_mappings": [
        {"source_name": "Route target", "source_model": "ipam.RouteTarget", "source_path": "ipam/route-targets/", "destination_kind": "route_target"},
        {"source_name": "VRF", "source_model": "ipam.VRF", "source_path": "ipam/vrfs/", "destination_kind": "vrf"}
      ]
    },
    {
      "id": "ipam_vlans",
      "title": "IPAM VLANs",
      "description": "VLAN groups, VLANs, and translation policies, including cluster-backed scopes. VPN terminations remain outside this provider graph.",
      "resource_kinds": ["vlan_group", "vlan", "vlan_translation_policy", "vlan_translation_rule"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["locations", "racks", "virtualization_clusters"],
      "data_mappings": [
        {"source_name": "VLAN group", "source_model": "ipam.VLANGroup", "source_path": "ipam/vlan-groups/", "destination_kind": "vlan_group"},
        {"source_name": "VLAN", "source_model": "ipam.VLAN", "source_path": "ipam/vlans/", "destination_kind": "vlan"},
        {"source_name": "VLAN translation policy", "source_model": "ipam.VLANTranslationPolicy", "source_path": "ipam/vlan-translation-policies/", "destination_kind": "vlan_translation_policy"},
        {"source_name": "VLAN translation rule", "source_model": "ipam.VLANTranslationRule", "source_path": "ipam/vlan-translation-rules/", "destination_kind": "vlan_translation_rule"}
      ]
    },
    {
      "id": "ipam_prefixes",
      "title": "IPAM prefixes and ranges",
      "description": "Prefixes and IP ranges with supported DCIM scopes, VRFs, VLANs, roles, tenancy, ownership, and tags.",
      "resource_kinds": ["prefix", "ip_range"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["ipam_routing", "ipam_vlans"],
      "data_mappings": [
        {"source_name": "Prefix", "source_model": "ipam.Prefix", "source_path": "ipam/prefixes/", "destination_kind": "prefix"},
        {"source_name": "IP range", "source_model": "ipam.IPRange", "source_path": "ipam/ip-ranges/", "destination_kind": "ip_range"}
      ]
    },
    {
      "id": "ipam_addresses",
      "title": "IPAM addresses and FHRP",
      "description": "IP addresses, FHRP groups, and physical or virtual interface assignments. FHRP authentication keys remain destination-local.",
      "resource_kinds": ["fhrp_group", "ip_address", "fhrp_group_assignment"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["ipam_prefixes", "device_components"],
      "data_mappings": [
        {"source_name": "FHRP group", "source_model": "ipam.FHRPGroup", "source_path": "ipam/fhrp-groups/", "destination_kind": "fhrp_group"},
        {"source_name": "IP address", "source_model": "ipam.IPAddress", "source_path": "ipam/ip-addresses/", "destination_kind": "ip_address"},
        {"source_name": "FHRP group assignment", "source_model": "ipam.FHRPGroupAssignment", "source_path": "ipam/fhrp-group-assignments/", "destination_kind": "fhrp_group_assignment"}
      ]
    },
    {
      "id": "ipam_services",
      "title": "IPAM services",
      "description": "Service templates and services bound to supported devices or FHRP groups. Virtual-machine services remain outside this provider graph.",
      "resource_kinds": ["service_template", "service"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["ipam_addresses"],
      "data_mappings": [
        {"source_name": "Service template", "source_model": "ipam.ServiceTemplate", "source_path": "ipam/service-templates/", "destination_kind": "service_template"},
        {"source_name": "Service", "source_model": "ipam.Service", "source_path": "ipam/services/", "destination_kind": "service"}
      ]
    },
    {
      "id": "data_sources",
      "title": "Core data sources",
      "description": "Portable Data Source configuration. Credentials, generated files, synchronization state, jobs, audit history, object-type metadata, and background worker state are never copied.",
      "resource_kinds": ["data_source"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["references"],
      "data_mappings": [
        {"source_name": "Data source", "source_model": "core.DataSource", "source_path": "core/data-sources/", "destination_kind": "data_source"}
      ]
    },
    {
      "id": "users",
      "title": "Users and access control",
      "description": "Users, groups, and object permissions. Passwords, API tokens, superuser state, login activity, built-in Django permissions, and private user preferences are never copied.",
      "resource_kinds": ["object_permission", "user_group", "user"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [],
      "data_mappings": [
        {"source_name": "Object permission", "source_model": "users.ObjectPermission", "source_path": "users/permissions/", "destination_kind": "object_permission"},
        {"source_name": "Group", "source_model": "users.Group", "source_path": "users/groups/", "destination_kind": "user_group"},
        {"source_name": "User", "source_model": "users.User", "source_path": "users/users/", "destination_kind": "user"}
      ]
    },
    {
      "id": "extras_customization",
      "title": "Extras customization",
      "description": "Custom fields and choice sets, custom links, and export templates. Synced template content is flattened; source file bindings and sync state remain local.",
      "resource_kinds": ["custom_field_choice_set", "custom_field", "custom_link", "export_template"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["references"],
      "data_mappings": [
        {"source_name": "Custom field choice set", "source_model": "extras.CustomFieldChoiceSet", "source_path": "extras/custom-field-choice-sets/", "destination_kind": "custom_field_choice_set"},
        {"source_name": "Custom field", "source_model": "extras.CustomField", "source_path": "extras/custom-fields/", "destination_kind": "custom_field"},
        {"source_name": "Custom link", "source_model": "extras.CustomLink", "source_path": "extras/custom-links/", "destination_kind": "custom_link"},
        {"source_name": "Export template", "source_model": "extras.ExportTemplate", "source_path": "extras/export-templates/", "destination_kind": "export_template"}
      ]
    },
    {
      "id": "extras_templates",
      "title": "Configuration templates",
      "description": "Portable configuration template definitions and inline template content. Data Source file bindings and synchronization state remain destination-local.",
      "resource_kinds": ["config_template"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["references"],
      "data_mappings": [
        {"source_name": "Config template", "source_model": "extras.ConfigTemplate", "source_path": "extras/config-templates/", "destination_kind": "config_template"}
      ]
    },
    {
      "id": "extras_views",
      "title": "Shared views",
      "description": "Saved filters and table configurations, including their optional user ownership and target object types.",
      "resource_kinds": ["saved_filter", "table_config"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["users"],
      "data_mappings": [
        {"source_name": "Saved filter", "source_model": "extras.SavedFilter", "source_path": "extras/saved-filters/", "destination_kind": "saved_filter"},
        {"source_name": "Table config", "source_model": "extras.TableConfig", "source_path": "extras/table-configs/", "destination_kind": "table_config"}
      ]
    },
    {
      "id": "extras_automation",
      "title": "Event automation",
      "description": "Webhooks, notification groups, and event rules. Webhook secrets, extra headers, CA paths, script actions, and API-inaccessible rule data remain local.",
      "resource_kinds": ["webhook", "notification_group", "event_rule"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["references", "users"],
      "data_mappings": [
        {"source_name": "Webhook", "source_model": "extras.Webhook", "source_path": "extras/webhooks/", "destination_kind": "webhook"},
        {"source_name": "Notification group", "source_model": "extras.NotificationGroup", "source_path": "extras/notification-groups/", "destination_kind": "notification_group"},
        {"source_name": "Event rule", "source_model": "extras.EventRule", "source_path": "extras/event-rules/", "destination_kind": "event_rule"}
      ]
    },
    {
      "id": "regions",
      "title": "Regions",
      "description": "Complete Region hierarchy, core fields, ownership references, and tags.",
      "resource_kinds": [
        "region"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [
        "references"
      ],
      "data_mappings": [
        {"source_name": "Region", "source_model": "dcim.Region", "source_path": "dcim/regions/", "destination_kind": "region"}
      ]
    },
    {
      "id": "sites",
      "title": "Sites",
      "description": "Complete Site fields and Region placement, including reference identities and tags.",
      "resource_kinds": [
        "site"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [
        "regions"
      ],
      "data_mappings": [
        {"source_name": "Site", "source_model": "dcim.Site", "source_path": "dcim/sites/", "destination_kind": "site"}
      ]
    },
    {
      "id": "locations",
      "title": "Locations",
      "description": "Complete Location hierarchy and Site placement, including reference identities and tags.",
      "resource_kinds": [
        "location"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [
        "sites"
      ],
      "data_mappings": [
        {"source_name": "Location", "source_model": "dcim.Location", "source_path": "dcim/locations/", "destination_kind": "location"}
      ]
    },
    {
      "id": "device_catalog",
      "title": "Device catalog",
      "description": "Manufacturers, hierarchical device roles and platforms, and complete device-type core fields.",
      "resource_kinds": [
        "manufacturer",
        "device_role",
        "platform",
        "device_type"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [
        "references",
        "extras_templates"
      ],
      "data_mappings": [
        {"source_name": "Manufacturer", "source_model": "dcim.Manufacturer", "source_path": "dcim/manufacturers/", "destination_kind": "manufacturer"},
        {"source_name": "Device role", "source_model": "dcim.DeviceRole", "source_path": "dcim/device-roles/", "destination_kind": "device_role"},
        {"source_name": "Platform", "source_model": "dcim.Platform", "source_path": "dcim/platforms/", "destination_kind": "platform"},
        {"source_name": "Device type", "source_model": "dcim.DeviceType", "source_path": "dcim/device-types/", "destination_kind": "device_type"}
      ]
    },
    {
      "id": "extras_contexts",
      "title": "Configuration contexts",
      "description": "Configuration context profiles and contexts for supported DCIM, tenancy, and virtualization qualifiers. Data Source file bindings remain local.",
      "resource_kinds": ["config_context_profile", "config_context"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["locations", "device_catalog", "virtualization_clusters"],
      "data_mappings": [
        {"source_name": "Config context profile", "source_model": "extras.ConfigContextProfile", "source_path": "extras/config-context-profiles/", "destination_kind": "config_context_profile"},
        {"source_name": "Config context", "source_model": "extras.ConfigContext", "source_path": "extras/config-contexts/", "destination_kind": "config_context"}
      ]
    },
    {
      "id": "racks",
      "title": "Racks",
      "description": "Rack groups, roles, types, and racks with complete core physical and placement fields.",
      "resource_kinds": [
        "rack_group",
        "rack_role",
        "rack_type",
        "rack"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [
        "locations",
        "device_catalog"
      ],
      "data_mappings": [
        {"source_name": "Rack group", "source_model": "dcim.RackGroup", "source_path": "dcim/rack-groups/", "destination_kind": "rack_group"},
        {"source_name": "Rack role", "source_model": "dcim.RackRole", "source_path": "dcim/rack-roles/", "destination_kind": "rack_role"},
        {"source_name": "Rack type", "source_model": "dcim.RackType", "source_path": "dcim/rack-types/", "destination_kind": "rack_type"},
        {"source_name": "Rack", "source_model": "dcim.Rack", "source_path": "dcim/racks/", "destination_kind": "rack"}
      ]
    },
    {
      "id": "module_catalog",
      "title": "Module catalog",
      "description": "Module type profiles, module types, and inventory item roles.",
      "resource_kinds": ["module_type_profile", "module_type", "inventory_item_role"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["device_catalog"],
      "data_mappings": [
        {"source_name": "Module type profile", "source_model": "dcim.ModuleTypeProfile", "source_path": "dcim/module-type-profiles/", "destination_kind": "module_type_profile"},
        {"source_name": "Module type", "source_model": "dcim.ModuleType", "source_path": "dcim/module-types/", "destination_kind": "module_type"},
        {"source_name": "Inventory item role", "source_model": "dcim.InventoryItemRole", "source_path": "dcim/inventory-item-roles/", "destination_kind": "inventory_item_role"}
      ]
    },
    {
      "id": "component_templates",
      "title": "Component templates",
      "description": "All reusable Device Type and Module Type component definitions.",
      "resource_kinds": [
        "console_port_template", "console_server_port_template", "power_port_template", "power_outlet_template",
        "interface_template", "rear_port_template", "front_port_template", "module_bay_template",
        "device_bay_template", "inventory_item_template"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["module_catalog"],
      "data_mappings": [
        {"source_name": "Console port template", "source_model": "dcim.ConsolePortTemplate", "source_path": "dcim/console-port-templates/", "destination_kind": "console_port_template"},
        {"source_name": "Console server port template", "source_model": "dcim.ConsoleServerPortTemplate", "source_path": "dcim/console-server-port-templates/", "destination_kind": "console_server_port_template"},
        {"source_name": "Power port template", "source_model": "dcim.PowerPortTemplate", "source_path": "dcim/power-port-templates/", "destination_kind": "power_port_template"},
        {"source_name": "Power outlet template", "source_model": "dcim.PowerOutletTemplate", "source_path": "dcim/power-outlet-templates/", "destination_kind": "power_outlet_template"},
        {"source_name": "Interface template", "source_model": "dcim.InterfaceTemplate", "source_path": "dcim/interface-templates/", "destination_kind": "interface_template"},
        {"source_name": "Rear port template", "source_model": "dcim.RearPortTemplate", "source_path": "dcim/rear-port-templates/", "destination_kind": "rear_port_template"},
        {"source_name": "Front port template", "source_model": "dcim.FrontPortTemplate", "source_path": "dcim/front-port-templates/", "destination_kind": "front_port_template"},
        {"source_name": "Module bay template", "source_model": "dcim.ModuleBayTemplate", "source_path": "dcim/module-bay-templates/", "destination_kind": "module_bay_template"},
        {"source_name": "Device bay template", "source_model": "dcim.DeviceBayTemplate", "source_path": "dcim/device-bay-templates/", "destination_kind": "device_bay_template"},
        {"source_name": "Inventory item template", "source_model": "dcim.InventoryItemTemplate", "source_path": "dcim/inventory-item-templates/", "destination_kind": "inventory_item_template"}
      ]
    },
    {
      "id": "devices",
      "title": "Devices",
      "description": "Virtual chassis and physical devices with complete DCIM-native placement and catalog references.",
      "resource_kinds": ["virtual_chassis", "device"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["racks", "component_templates"],
      "data_mappings": [
        {"source_name": "Virtual chassis", "source_model": "dcim.VirtualChassis", "source_path": "dcim/virtual-chassis/", "destination_kind": "virtual_chassis"},
        {"source_name": "Device", "source_model": "dcim.Device", "source_path": "dcim/devices/", "destination_kind": "device"}
      ]
    },
    {
      "id": "device_components",
      "title": "Device components",
      "description": "Modules, virtual contexts, installed ports, interfaces, bays, inventory, and MAC addresses including VM interface assignments.",
      "resource_kinds": [
        "virtual_device_context", "module_bay", "device_bay", "module", "console_port", "console_server_port",
        "power_port", "power_outlet", "interface", "rear_port", "front_port", "inventory_item", "mac_address"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["devices", "virtualization_components"],
