{
  "provider_id": "netbox",
  "display_name": "NetBox",
  "icon_class": "mdi mdi-cube-outline",
  "description": "Collects infrastructure and IPAM data from a remote NetBox REST API.",
  "instance_url_field": "base_url",
  "implementation_version": "0.0.9",
  "contract_version": "1.0",
  "documentation_url": "https://github.com/abhi1693/netbox-ssot",
  "execution_modes": [
    "agent"
  ],
  "capabilities": [
    "source_read"
  ],
  "agent_compatibility": {
    "protocol_version": "1.0",
    "minimum_agent_version": "0.1.0-alpha.0",
    "collector_id": "netbox"
  },
  "config_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "NetBox source configuration",
    "description": "Connection settings passed to an enrolled Go agent. Secret values remain agent-local.",
    "additionalProperties": false,
    "x-netbox-ssot-order": [
      "base_url",
      "token_ref",
      "verify_tls",
      "page_size",
      "timeout_seconds"
    ],
    "properties": {
      "base_url": {
        "type": "string",
        "title": "NetBox URL",
        "description": "Base URL of the source NetBox instance, without the /api path.",
        "format": "uri",
        "x-netbox-ssot-placeholder": "https://netbox.example.com"
      },
      "token_ref": {
        "type": "string",
        "title": "API token reference",
        "description": "Agent-local env:// or absolute file:/// secret reference. The token itself is never sent to the plugin.",
        "pattern": "^(env://[A-Z_][A-Z0-9_]*|file:///[^\\s?#]+)$",
        "writeOnly": true,
        "x-netbox-ssot-secret": true,
        "x-netbox-ssot-widget": "secret-reference"
      },
      "verify_tls": {
        "type": "boolean",
        "title": "Verify TLS",
        "description": "Require the source certificate to validate against the agent trust store.",
        "default": true
      },
      "page_size": {
        "type": "integer",
        "title": "REST page size",
        "description": "Number of records requested per page. The source NetBox applies its configured MAX_PAGE_SIZE.",
        "default": 500,
        "minimum": 1
      },
      "timeout_seconds": {
        "type": "number",
        "title": "Request timeout",
        "description": "Per-request timeout in seconds.",
        "default": 30,
        "minimum": 1,
        "maximum": 120
      }
    },
    "required": [
      "base_url",
      "token_ref"
    ]
  },
  "secret_fields": [
    "/token_ref"
  ],
  "datasets": [
    {
      "id": "references",
      "title": "Supporting references",
      "description": "Automatically collected ownership, tenancy, tagging, grouping, and ASN dependencies.",
      "resource_kinds": [
        "tag",
        "owner_group",
        "owner",
        "tenant_group",
        "tenant",
        "site_group",
        "rir",
        "asn"
      ],
      "default_enabled": false,
      "selectable": false,
      "completeness": "declared_scope",
      "depends_on": [],
      "data_mappings": [
        {"source_name": "Tag", "source_model": "extras.Tag", "source_path": "extras/tags/", "destination_kind": "tag"},
        {"source_name": "Owner group", "source_model": "users.OwnerGroup", "source_path": "users/owner-groups/", "destination_kind": "owner_group"},
        {"source_name": "Owner", "source_model": "users.Owner", "source_path": "users/owners/", "destination_kind": "owner"},
        {"source_name": "Tenant group", "source_model": "tenancy.TenantGroup", "source_path": "tenancy/tenant-groups/", "destination_kind": "tenant_group"},
        {"source_name": "Tenant", "source_model": "tenancy.Tenant", "source_path": "tenancy/tenants/", "destination_kind": "tenant"},
        {"source_name": "Site group", "source_model": "dcim.SiteGroup", "source_path": "dcim/site-groups/", "destination_kind": "site_group"},
        {"source_name": "RIR", "source_model": "ipam.RIR", "source_path": "ipam/rirs/", "destination_kind": "rir"},
        {"source_name": "ASN", "source_model": "ipam.ASN", "source_path": "ipam/asns/", "destination_kind": "asn"}
      ]
    },
    {
      "id": "users",
      "title": "Users and access control",
      "description": "Users, groups, and object permissions. Passwords, API tokens, superuser state, login activity, built-in Django permissions, and private user preferences are never copied.",
      "resource_kinds": ["object_permission", "user_group", "user"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [],
      "data_mappings": [
        {"source_name": "Object permission", "source_model": "users.ObjectPermission", "source_path": "users/permissions/", "destination_kind": "object_permission"},
        {"source_name": "Group", "source_model": "users.Group", "source_path": "users/groups/", "destination_kind": "user_group"},
        {"source_name": "User", "source_model": "users.User", "source_path": "users/users/", "destination_kind": "user"}
      ]
    },
    {
      "id": "regions",
      "title": "Regions",
      "description": "Complete Region hierarchy, core fields, ownership references, and tags.",
      "resource_kinds": [
        "region"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [
        "references"
      ],
      "data_mappings": [
        {"source_name": "Region", "source_model": "dcim.Region", "source_path": "dcim/regions/", "destination_kind": "region"}
      ]
    },
    {
      "id": "sites",
      "title": "Sites",
      "description": "Complete Site fields and Region placement, including reference identities and tags.",
      "resource_kinds": [
        "site"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [
        "regions"
      ],
      "data_mappings": [
        {"source_name": "Site", "source_model": "dcim.Site", "source_path": "dcim/sites/", "destination_kind": "site"}
      ]
    },
    {
      "id": "locations",
      "title": "Locations",
      "description": "Complete Location hierarchy and Site placement, including reference identities and tags.",
      "resource_kinds": [
        "location"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [
        "sites"
      ],
      "data_mappings": [
        {"source_name": "Location", "source_model": "dcim.Location", "source_path": "dcim/locations/", "destination_kind": "location"}
      ]
    },
    {
      "id": "device_catalog",
      "title": "Device catalog",
      "description": "Manufacturers, hierarchical device roles and platforms, and complete device-type core fields.",
      "resource_kinds": [
        "manufacturer",
        "device_role",
        "platform",
        "device_type"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [
        "references"
      ],
      "data_mappings": [
        {"source_name": "Manufacturer", "source_model": "dcim.Manufacturer", "source_path": "dcim/manufacturers/", "destination_kind": "manufacturer"},
        {"source_name": "Device role", "source_model": "dcim.DeviceRole", "source_path": "dcim/device-roles/", "destination_kind": "device_role"},
        {"source_name": "Platform", "source_model": "dcim.Platform", "source_path": "dcim/platforms/", "destination_kind": "platform"},
        {"source_name": "Device type", "source_model": "dcim.DeviceType", "source_path": "dcim/device-types/", "destination_kind": "device_type"}
      ]
    },
    {
      "id": "racks",
      "title": "Racks",
      "description": "Rack groups, roles, types, and racks with complete core physical and placement fields.",
      "resource_kinds": [
        "rack_group",
        "rack_role",
        "rack_type",
        "rack"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": [
        "locations",
        "device_catalog"
      ],
      "data_mappings": [
        {"source_name": "Rack group", "source_model": "dcim.RackGroup", "source_path": "dcim/rack-groups/", "destination_kind": "rack_group"},
        {"source_name": "Rack role", "source_model": "dcim.RackRole", "source_path": "dcim/rack-roles/", "destination_kind": "rack_role"},
        {"source_name": "Rack type", "source_model": "dcim.RackType", "source_path": "dcim/rack-types/", "destination_kind": "rack_type"},
        {"source_name": "Rack", "source_model": "dcim.Rack", "source_path": "dcim/racks/", "destination_kind": "rack"}
      ]
    },
    {
      "id": "module_catalog",
      "title": "Module catalog",
      "description": "Module type profiles, module types, and inventory item roles.",
      "resource_kinds": ["module_type_profile", "module_type", "inventory_item_role"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["device_catalog"],
      "data_mappings": [
        {"source_name": "Module type profile", "source_model": "dcim.ModuleTypeProfile", "source_path": "dcim/module-type-profiles/", "destination_kind": "module_type_profile"},
        {"source_name": "Module type", "source_model": "dcim.ModuleType", "source_path": "dcim/module-types/", "destination_kind": "module_type"},
        {"source_name": "Inventory item role", "source_model": "dcim.InventoryItemRole", "source_path": "dcim/inventory-item-roles/", "destination_kind": "inventory_item_role"}
      ]
    },
    {
      "id": "component_templates",
      "title": "Component templates",
      "description": "All reusable Device Type and Module Type component definitions.",
      "resource_kinds": [
        "console_port_template", "console_server_port_template", "power_port_template", "power_outlet_template",
        "interface_template", "rear_port_template", "front_port_template", "module_bay_template",
        "device_bay_template", "inventory_item_template"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["module_catalog"],
      "data_mappings": [
        {"source_name": "Console port template", "source_model": "dcim.ConsolePortTemplate", "source_path": "dcim/console-port-templates/", "destination_kind": "console_port_template"},
        {"source_name": "Console server port template", "source_model": "dcim.ConsoleServerPortTemplate", "source_path": "dcim/console-server-port-templates/", "destination_kind": "console_server_port_template"},
        {"source_name": "Power port template", "source_model": "dcim.PowerPortTemplate", "source_path": "dcim/power-port-templates/", "destination_kind": "power_port_template"},
        {"source_name": "Power outlet template", "source_model": "dcim.PowerOutletTemplate", "source_path": "dcim/power-outlet-templates/", "destination_kind": "power_outlet_template"},
        {"source_name": "Interface template", "source_model": "dcim.InterfaceTemplate", "source_path": "dcim/interface-templates/", "destination_kind": "interface_template"},
        {"source_name": "Rear port template", "source_model": "dcim.RearPortTemplate", "source_path": "dcim/rear-port-templates/", "destination_kind": "rear_port_template"},
        {"source_name": "Front port template", "source_model": "dcim.FrontPortTemplate", "source_path": "dcim/front-port-templates/", "destination_kind": "front_port_template"},
        {"source_name": "Module bay template", "source_model": "dcim.ModuleBayTemplate", "source_path": "dcim/module-bay-templates/", "destination_kind": "module_bay_template"},
        {"source_name": "Device bay template", "source_model": "dcim.DeviceBayTemplate", "source_path": "dcim/device-bay-templates/", "destination_kind": "device_bay_template"},
        {"source_name": "Inventory item template", "source_model": "dcim.InventoryItemTemplate", "source_path": "dcim/inventory-item-templates/", "destination_kind": "inventory_item_template"}
      ]
    },
    {
      "id": "devices",
      "title": "Devices",
      "description": "Virtual chassis and physical devices with complete DCIM-native placement and catalog references.",
      "resource_kinds": ["virtual_chassis", "device"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["racks", "component_templates"],
      "data_mappings": [
        {"source_name": "Virtual chassis", "source_model": "dcim.VirtualChassis", "source_path": "dcim/virtual-chassis/", "destination_kind": "virtual_chassis"},
        {"source_name": "Device", "source_model": "dcim.Device", "source_path": "dcim/devices/", "destination_kind": "device"}
      ]
    },
    {
      "id": "device_components",
      "title": "Device components",
      "description": "Modules, virtual contexts, installed ports, interfaces, bays, inventory, and MAC addresses.",
      "resource_kinds": [
        "virtual_device_context", "module_bay", "device_bay", "module", "console_port", "console_server_port",
        "power_port", "power_outlet", "interface", "rear_port", "front_port", "inventory_item", "mac_address"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["devices"],
      "data_mappings": [
        {"source_name": "Virtual device context", "source_model": "dcim.VirtualDeviceContext", "source_path": "dcim/virtual-device-contexts/", "destination_kind": "virtual_device_context"},
        {"source_name": "Module bay", "source_model": "dcim.ModuleBay", "source_path": "dcim/module-bays/", "destination_kind": "module_bay"},
        {"source_name": "Device bay", "source_model": "dcim.DeviceBay", "source_path": "dcim/device-bays/", "destination_kind": "device_bay"},
        {"source_name": "Module", "source_model": "dcim.Module", "source_path": "dcim/modules/", "destination_kind": "module"},
        {"source_name": "Console port", "source_model": "dcim.ConsolePort", "source_path": "dcim/console-ports/", "destination_kind": "console_port"},
        {"source_name": "Console server port", "source_model": "dcim.ConsoleServerPort", "source_path": "dcim/console-server-ports/", "destination_kind": "console_server_port"},
        {"source_name": "Power port", "source_model": "dcim.PowerPort", "source_path": "dcim/power-ports/", "destination_kind": "power_port"},
        {"source_name": "Power outlet", "source_model": "dcim.PowerOutlet", "source_path": "dcim/power-outlets/", "destination_kind": "power_outlet"},
        {"source_name": "Interface", "source_model": "dcim.Interface", "source_path": "dcim/interfaces/", "destination_kind": "interface"},
        {"source_name": "Rear port", "source_model": "dcim.RearPort", "source_path": "dcim/rear-ports/", "destination_kind": "rear_port"},
        {"source_name": "Front port", "source_model": "dcim.FrontPort", "source_path": "dcim/front-ports/", "destination_kind": "front_port"},
        {"source_name": "Inventory item", "source_model": "dcim.InventoryItem", "source_path": "dcim/inventory-items/", "destination_kind": "inventory_item"},
        {"source_name": "MAC address", "source_model": "dcim.MACAddress", "source_path": "dcim/mac-addresses/", "destination_kind": "mac_address"}
      ]
    },
    {
      "id": "rack_reservations",
      "title": "Rack reservations",
      "description": "Reserved rack units and their destination user references.",
      "resource_kinds": ["rack_reservation"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["racks"],
      "data_mappings": [
        {"source_name": "Rack reservation", "source_model": "dcim.RackReservation", "source_path": "dcim/rack-reservations/", "destination_kind": "rack_reservation"}
      ]
    },
    {
      "id": "power",
      "title": "Power",
      "description": "Power panels and feeds including rack placement and electrical characteristics.",
      "resource_kinds": ["power_panel", "power_feed"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["racks"],
      "data_mappings": [
        {"source_name": "Power panel", "source_model": "dcim.PowerPanel", "source_path": "dcim/power-panels/", "destination_kind": "power_panel"},
        {"source_name": "Power feed", "source_model": "dcim.PowerFeed", "source_path": "dcim/power-feeds/", "destination_kind": "power_feed"}
      ]
    },
    {
      "id": "circuit_catalog",
      "title": "Circuit catalog",
      "description": "Providers, provider accounts and networks, physical and virtual circuit types, and circuit groups.",
      "resource_kinds": [
        "provider", "provider_account", "provider_network", "circuit_type", "virtual_circuit_type", "circuit_group"
      ],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["references"],
      "data_mappings": [
        {"source_name": "Provider", "source_model": "circuits.Provider", "source_path": "circuits/providers/", "destination_kind": "provider"},
        {"source_name": "Provider account", "source_model": "circuits.ProviderAccount", "source_path": "circuits/provider-accounts/", "destination_kind": "provider_account"},
        {"source_name": "Provider network", "source_model": "circuits.ProviderNetwork", "source_path": "circuits/provider-networks/", "destination_kind": "provider_network"},
        {"source_name": "Circuit type", "source_model": "circuits.CircuitType", "source_path": "circuits/circuit-types/", "destination_kind": "circuit_type"},
        {"source_name": "Virtual circuit type", "source_model": "circuits.VirtualCircuitType", "source_path": "circuits/virtual-circuit-types/", "destination_kind": "virtual_circuit_type"},
        {"source_name": "Circuit group", "source_model": "circuits.CircuitGroup", "source_path": "circuits/circuit-groups/", "destination_kind": "circuit_group"}
      ]
    },
    {
      "id": "circuits",
      "title": "Circuits",
      "description": "Physical circuits and their A/Z terminations, including provider, tenancy, geography, and tagging relationships.",
      "resource_kinds": ["circuit", "circuit_termination"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["locations", "circuit_catalog"],
      "data_mappings": [
        {"source_name": "Circuit", "source_model": "circuits.Circuit", "source_path": "circuits/circuits/", "destination_kind": "circuit"},
        {"source_name": "Circuit termination", "source_model": "circuits.CircuitTermination", "source_path": "circuits/circuit-terminations/", "destination_kind": "circuit_termination"}
      ]
    },
    {
      "id": "virtual_circuits",
      "title": "Virtual circuits",
      "description": "Virtual circuits and their virtual-interface terminations.",
      "resource_kinds": ["virtual_circuit", "virtual_circuit_termination"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["device_components", "circuit_catalog"],
      "data_mappings": [
        {"source_name": "Virtual circuit", "source_model": "circuits.VirtualCircuit", "source_path": "circuits/virtual-circuits/", "destination_kind": "virtual_circuit"},
        {"source_name": "Virtual circuit termination", "source_model": "circuits.VirtualCircuitTermination", "source_path": "circuits/virtual-circuit-terminations/", "destination_kind": "virtual_circuit_termination"}
      ]
    },
    {
      "id": "circuit_group_assignments",
      "title": "Circuit group assignments",
      "description": "Physical and virtual circuit membership in administrative circuit groups.",
      "resource_kinds": ["circuit_group_assignment"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["circuits", "virtual_circuits"],
      "data_mappings": [
        {"source_name": "Circuit group assignment", "source_model": "circuits.CircuitGroupAssignment", "source_path": "circuits/circuit-group-assignments/", "destination_kind": "circuit_group_assignment"}
      ]
    },
    {
      "id": "cabling",
      "title": "Cabling",
      "description": "Cable bundles and cables with endpoint terminations managed as one aggregate.",
      "resource_kinds": ["cable_bundle", "cable"],
      "default_enabled": true,
      "completeness": "declared_scope",
      "depends_on": ["device_components", "power", "circuits"],
      "data_mappings": [
        {"source_name": "Cable bundle", "source_model": "dcim.CableBundle", "source_path": "dcim/cable-bundles/", "destination_kind": "cable_bundle"},
        {"source_name": "Cable", "source_model": "dcim.Cable", "source_path": "dcim/cables/", "destination_kind": "cable"}
      ]
    }
  ]
}
